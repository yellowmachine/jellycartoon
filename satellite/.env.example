# El satélite de voz (#296), en su .env, junto a compose.prod.yaml.

# Seilide, y la clave del satélite: Ajustes → Familia → «Satélites de voz» → Añadir, que enseña
# las dos.
SERVER_URL=""
SATELLITE_KEY=""

# El micrófono y el altavoz, como los nombra ALSA (`arecord -L`, `aplay -L`): por ejemplo
# plughw:CARD=Microphone y plughw:CARD=Headphones. Vacío el altavoz: el de por defecto.
MIC="default"
MIC_RATE="48000"
MIC_CHANNELS="2"
SPEAKER=""
# La música de la casa (su snapserver, en Ajustes de Seilide), por otro dispositivo que el de la
# voz: vacío, el mismo.
SNAPCLIENT_SOUNDCARD=""

# La palabra que lo despierta: hola_casita, alexa, okapi, ocarina, kusanagi, makoto u oye_alizee, hasta que la familia
# elija una en Seilide (Ajustes), que entonces vale para todos. Y cuánto tiene que parecerse (0 a 1).
WAKE_WORD="alexa"
WAKE_THRESHOLD="0.5"

# Cortarle mientras habla o piensa diciendo la palabra (#373): 1, sí. Mejor con un micrófono con
# cancelación de eco (reSpeaker XVF3800, con el altavoz en su salida); sin él, oye su propia voz.
BARGE_IN="0"

TZ="Europe/Madrid"

# El DNS de la casa (AdGuard Home), solo en uno de los satélites: COMPOSE_PROFILES="dns". Ver
# README, «El DNS de la casa».
COMPOSE_PROFILES=""

# Opcional (#643): con ella, su página http://<satélite>:8790/alta abre el alta de aparatos, como
# decirle «añade un aparato». Una nueva, por ejemplo `openssl rand -hex 16`; nunca la SATELLITE_KEY.
ALTA_CLAVE=""

# La imagen que corre, por su digest: la pone actualizar.sh (#643), solo si está firmada con
# cosign.pub. No se toca a mano.
SATELLITE_IMAGE=""

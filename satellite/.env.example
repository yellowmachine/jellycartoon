# El satélite de voz (#296), en su .env, junto a compose.prod.yaml.

# Seilide, y la clave del satélite: Ajustes → Familia → «Satélites de voz» → Añadir, que enseña
# las dos.
SERVER_URL=""
SATELLITE_KEY=""

# El micrófono y el altavoz, como los nombra ALSA (`arecord -L`, `aplay -L`): por ejemplo
# plughw:CARD=Microphone y plughw:CARD=Headphones. Vacío el altavoz: el de por defecto.
MIC="default"
MIC_RATE="48000"
MIC_CHANNELS="2"
SPEAKER=""
# La música de la casa (su snapserver, en Ajustes de Seilide), por otro dispositivo que el de la
# voz: vacío, el mismo.
SNAPCLIENT_SOUNDCARD=""

# La palabra que lo despierta: hola_casita o alexa; y cuánto tiene que parecerse (0 a 1).
WAKE_WORD="alexa"
WAKE_THRESHOLD="0.5"

TZ="Europe/Madrid"

# El DNS de la casa (AdGuard Home), solo en uno de los satélites: COMPOSE_PROFILES="dns". Ver
# README, «El DNS de la casa».
COMPOSE_PROFILES=""

# La de WUD, que lo actualiza cada noche: desde su 9.6 no arranca sin un administrador. Una nueva,
# por ejemplo con `openssl rand -hex 16`. Su web no se abre fuera del satélite.
WUD_PASSWORD=""

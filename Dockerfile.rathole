# syntax=docker/dockerfile:1
# rathole for compose.prod.yaml (`tunel` profile, #253), for a PC (amd64) and a Raspberry (arm64,
# #378): rapiz1/rathole:v0.5.0 is only amd64, but its v0.5.0 release has the program built for both
# (https://github.com/rapiz1/rathole/releases/tag/v0.5.0), statically linked. Each one's zip as
# released, checked by its sha256; then as its own image does (its Dockerfile): /app/rathole, user
# 1000, on distroless/cc (the amd64 one, though static, does not start without its C libraries).
ARG RATHOLE_VERSION=v0.5.0

FROM scratch AS zip-amd64
ARG RATHOLE_VERSION
ADD --checksum=sha256:3e7d0d0f365120cd3cd351d147d1a12ee960c8068b464d4dd533a3821873b80e \
	https://github.com/rapiz1/rathole/releases/download/${RATHOLE_VERSION}/rathole-x86_64-unknown-linux-gnu.zip /rathole.zip

FROM scratch AS zip-arm64
ARG RATHOLE_VERSION
ADD --checksum=sha256:fa4a6fc63d86f8f1faa7c103a845e4715ce79a048455c0eec897b27237576564 \
	https://github.com/rapiz1/rathole/releases/download/${RATHOLE_VERSION}/rathole-aarch64-unknown-linux-musl.zip /rathole.zip

FROM zip-${TARGETARCH} AS zip

# Unzipped where it is built: the same for both.
FROM --platform=$BUILDPLATFORM busybox:1.37 AS unzip
COPY --from=zip /rathole.zip /tmp/rathole.zip
RUN unzip /tmp/rathole.zip -d /out && chmod 755 /out/rathole

FROM gcr.io/distroless/cc-debian12
WORKDIR /app
COPY --from=unzip /out/rathole .
USER 1000:1000
ENTRYPOINT ["./rathole"]

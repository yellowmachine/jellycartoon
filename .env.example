# Drizzle
DATABASE_URL="postgres://jellycartoon:jellycartoon@localhost:5432/jellycartoon"

# URL desde la que se accede a la app; se lee al arrancar
# (desarrollo: http://localhost:5173, producción: el dominio que sirve Caddy, https://<tu-dominio>)
ORIGIN="http://localhost:5173"

# Better Auth: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Biblioteca
MEDIA_DIR="./media"
DATA_DIR="./data"
AUDIO_LANG="spa"
X264_PRESET="medium"
X264_CRF="20"
ALLOW_SIGNUP="true"
# Borra de MEDIA_DIR los originales (y sus subtítulos) una vez convertidos
DELETE_SOURCES="false"

# Solo para producción (compose.prod.yaml). Con HOST_DATA_DIR absoluto, cada capítulo convertido
# tiene un botón para copiar su ruta y abrirlo con mpv u otro reproductor en el mismo PC.
HOST_MEDIA_DIR="./media"
HOST_DATA_DIR="./data"
# Token de API de Cloudflare para el certificado de Caddy (reto DNS-01), con los permisos
# Zone.Zone:Read y Zone.DNS:Edit sobre la zona del dominio de ORIGIN.
CF_API_TOKEN="tu-token-de-cloudflare"
# Opcional: carpeta de películas en el host (ruta absoluta). Se catalogan sin convertir y aparece
# la sección Cine. En desarrollo, usa CINEMA_DIR con la ruta de la carpeta.
# HOST_CINEMA_DIR="/mnt/8tb/pelis"
# CINEMA_DIR="/mnt/8tb/pelis"
# Opcional: carpeta de música ripeada de CD (FLAC con etiquetas) en el host (ruta absoluta).
# Aparece la sección Música. En desarrollo, usa MUSIC_DIR con la ruta de la carpeta.
# HOST_MUSIC_DIR="/mnt/8tb/musica"
# MUSIC_DIR="/home/yo/musica"
# Opcional: la música también a Snapcast (snapserver y un mpv que suena en él, en el compose; ver
# el README). En desarrollo, MUSIC_MPV_SOCKET con el socket de ese mpv.
# COMPOSE_PROFILES="snapcast"
# MUSIC_MPV_SOCKET="/ruta/a/mpv-music.sock"
# SNAPSERVER_CONTROL="localhost:1705"
# Para ver películas y capítulos en mpv, en el salón (desarrollo; en producción va solo con
# HOST_CINEMA_DIR, y sin películas se activa con MPV_SOCKET="/data/mpv.sock"):
# MPV_SOCKET="/run/user/1000/mpv.sock"
# Opcional: clave de OpenRouter para la IA de las películas (también se puede poner en Ajustes;
# esta manda) y el modelo para identificarlas.
# OPENROUTER_API_KEY="sk-or-..."
# OPENROUTER_MODEL="anthropic/claude-haiku-5.5"
# Opcional: clave de openrouteservice para las rutas del modo carretera (#78; también se puede
# poner en Ajustes; esta manda). Gratis en https://openrouteservice.org.
# OPENROUTESERVICE_API_KEY="..."
# Opcional: el repetidor para compartir viajes del modo carretera (relay/, #81), y su PUBLISH_KEY
# (también en Ajustes; estas mandan).
# RELAY_URL="https://viaje.example.com"
# RELAY_PUBLISH_KEY="..."
# Opcional: órdenes por voz (#33). Con `voz` en COMPOSE_PROFILES (p. ej. "snapcast,voz") arranca
# Whisper en la GPU; WHISPER_MODEL es su modelo (small por defecto; medium entiende mejor y tarda
# más). En desarrollo, WHISPER_URL con la dirección de un whisper-server arrancado con --convert.
# WHISPER_MODEL="small"
# WHISPER_URL="http://localhost:8080"
# PUID=1000
# PGID=1000
# IMAGE_TAG=latest

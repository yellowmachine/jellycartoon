# Drizzle
DATABASE_URL="postgres://jellycartoon:jellycartoon@localhost:5432/jellycartoon"

# URL desde la que se accede a la app (en LAN usa la IP del servidor)
ORIGIN="http://localhost:5173"

# Better Auth: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Biblioteca
MEDIA_DIR="./media"
DATA_DIR="./data"
AUDIO_LANG="spa"
X264_PRESET="medium"
X264_CRF="20"
ALLOW_SIGNUP="true"

# Solo para `docker compose --profile app up`
APP_ORIGIN="http://localhost:3000"
HOST_MEDIA_DIR="./media"
HOST_DATA_DIR="./data"

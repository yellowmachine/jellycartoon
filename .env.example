# Drizzle
DATABASE_URL="postgres://jellycartoon:jellycartoon@localhost:5432/jellycartoon"

# URL desde la que se accede a la app; se lee al arrancar
# (desarrollo: http://localhost:5173, producción: p. ej. http://192.168.1.10:3000)
ORIGIN="http://localhost:5173"

# Better Auth: `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Biblioteca
MEDIA_DIR="./media"
DATA_DIR="./data"
AUDIO_LANG="spa"
X264_PRESET="medium"
X264_CRF="20"
ALLOW_SIGNUP="true"
# Borra de MEDIA_DIR los originales (y sus subtítulos) una vez convertidos
DELETE_SOURCES="false"

# Solo para producción (compose.prod.yaml)
HOST_MEDIA_DIR="./media"
HOST_DATA_DIR="./data"
# PUID=1000
# PGID=1000
# IMAGE_TAG=latest

{
	"name": "jellycartoon",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun run db:migrate && bun --bun vite dev --host",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:start": "docker compose up -d db",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"quitar-2fa": "bun scripts/quitar-2fa.ts",
		"db:studio": "bun --bun drizzle-kit studio",
		"auth:schema": "bun --bun x auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"start": "bun build/index.js",
		"test": "bun test src"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^20",
		"@types/qrcode": "^1.5.6",
		"@types/web-push": "^3.6.4",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.11.2",
		"postgres": "^3.4.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible": "^5.3.0",
		"@fontsource/comic-neue": "^5.3.0",
		"@fontsource/fraunces": "^5.3.0",
		"@protomaps/basemaps": "^5.7.2",
		"@turf/buffer": "7",
		"@turf/helpers": "7",
		"@turf/simplify": "7",
		"hls.js": "^1.7.3",
		"maplibre-gl": "^6.12.0",
		"media-chrome": "^4.19.3",
		"minisearch": "^7.2.0",
		"onnxruntime-web": "1.30.0",
		"pmtiles": "^4.5.0",
		"qrcode": "^1.5.4",
		"rrule": "^2.8.1",
		"uqr": "0.1.2",
		"web-push": "^3.6.7"
	}
}

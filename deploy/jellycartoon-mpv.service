# mpv waiting, without a window, for JellyCartoon to send it films (Cine → ▶ Ver en el salón).
# A systemd user service on the PC with the screen; see "Ver en el salón" in the README.
[Unit]
Description=mpv para JellyCartoon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# @SOCKET@ is replaced on install: <HOST_DATA_DIR>/mpv.sock, which the app sees as /data/mpv.sock.
ExecStart=/usr/bin/mpv --idle --fs --input-ipc-server=@SOCKET@
# Closing mpv (q) leaves it waiting again.
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target

# mpv waiting, without a window, for JellyCartoon to send it films (Cine → ▶ Ver en el salón).
# A systemd user service on the PC with the screen; see "Ver en el salón" in the README.
[Unit]
Description=mpv para JellyCartoon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# @SOCKET@ is replaced on install: <HOST_DATA_DIR>/mpv.sock, which the app sees as /data/mpv.sock.
# Escape stops, as the remote's «Parar», instead of leaving fullscreen: on a TV remote it is «back»,
# and back is the app (the /tv view) under the window.
ExecStart=/usr/bin/mpv --idle --fs --input-ipc-server=@SOCKET@ --input-commands="keybind ESC stop"
# Closing mpv (q) leaves it waiting again.
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target

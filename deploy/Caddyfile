# HTTPS in front of the app (compose.prod.yaml, caddy service), in its image (Dockerfile.caddy):
# so that it is still there when WUD recreates the container. The site address comes from the
# environment when Caddy starts (https://caddyserver.com/docs/caddyfile/concepts#environment-variables):
# the same image for every install, each with its own ORIGIN in its .env.
{
	# On stopping (an update), open connections get this long to end, not forever: the app's live
	# events (the remote, the Snapcast bar) never end on their own, and Docker would kill Caddy after
	# 10 s with the site down. The pages connect again by themselves.
	# https://caddyserver.com/docs/caddyfile/options#grace-period
	grace_period 2s
	# With TLS=internal, its own root is not put in the container's trust store, which is no use:
	# it goes on each device by hand (README, «Solo en casa»).
	skip_install_trust
}

# The certificate, by TLS in the .env: `cloudflare` (the default), a real one from Let's Encrypt
# with Cloudflare's DNS-01 challenge, for a domain; `internal`, signed by Caddy's own authority,
# for an install only at home without a domain, whose root each device installs.
(tls-cloudflare) {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}

(tls-internal) {
	tls internal
}

# MEDIA_HOST (optional): a second name, reached from outside through the rathole tunnel (the
# `tunel` profile in compose.prod.yaml, #253). It serves only the APIs for other apps: Subsonic
# (/rest, e.g. Tempus) and the video one for the cloud (/api/v1); the rest of the app stays at
# home and on WireGuard.
{$ORIGIN} {$MEDIA_HOST} {
	import tls-{$TLS:cloudflare}

	# An expression rather than `host`: without MEDIA_HOST, it matches nothing (`host` with no name
	# would leave the whole site to the 404).
	@media-not-api expression `{host} == "{$MEDIA_HOST}" && !path('/rest/*', '/api/v1/*')`
	respond @media-not-api 404

	reverse_proxy app:3000

	# The app restarting (an update, a change in the compose): instead of a blank 502, a page that
	# tries again by itself every 3 s, and is the app's again as soon as it answers. In the app, a
	# request that gets this (the pages that follow something every few seconds) shows its error
	# page, which waits for it too (+error.svelte).
	# https://caddyserver.com/docs/caddyfile/directives/handle_errors
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Retry-After 3
		header Cache-Control no-store
		respond <<HTML
			<!doctype html>
			<html lang="es">
			<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<meta http-equiv="refresh" content="3">
			<title>Reiniciando · JellyCartoon</title>
			</head>
			<body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#09090b;color:#a1a1aa;font-family:system-ui,sans-serif;text-align:center;padding:16px">
			<div>
			<p style="color:#fbbf24;font-size:1.5rem;font-weight:bold;margin:0 0 .5rem">Un momento</p>
			<p style="margin:0">La app se está reiniciando: esta página vuelve sola en cuanto conteste.</p>
			</div>
			</body>
			</html>
			HTML 503
	}
}

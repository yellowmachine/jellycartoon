# Opens the Steam game whose appid JellyCartoon sends on the socket (jellycartoon-steam.socket):
# deploy/jellycartoon-steam.sh, installed by scripts/pantalla.sh.
[Unit]
Description=Abrir un juego de Steam para JellyCartoon

[Service]
StandardInput=socket
StandardOutput=journal
ExecStart=%h/.local/bin/jellycartoon-steam

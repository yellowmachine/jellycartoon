---
/**
 * Phone screenshots in the guide (#495), side by side and small: a phone's screen at the text's
 * whole width is taller than the window. Made by nube/scripts/capturas/capturas.ts, in
 * src/assets/guia/. Astro makes them smaller (astro:assets).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	shots: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { shots } = Astro.props;
---

<div class="capturas not-content">
	{
		shots.map((s) => (
			<figure>
				<Image src={s.src} alt={s.alt} width={260} densities={[1, 2]} />
				{s.caption && <figcaption>{s.caption}</figcaption>}
			</figure>
		))
	}
</div>

<style>
	.capturas {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-block: 1.5rem;
	}
	figure {
		margin: 0;
		/* Two side by side on a phone. */
		width: min(260px, calc(50% - 0.5rem));
	}
	img {
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
	}
	figcaption {
		margin-top: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>

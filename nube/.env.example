# La base de datos como el rol de la app (nube_app, scripts/init-db.sh), al que se aplica la
# seguridad por filas, y como su dueño solo para las migraciones. En desarrollo, las de compose.yaml.
DATABASE_URL="postgres://nube_app:nube_app@127.0.0.1:5435/nube"
MIGRATE_DATABASE_URL="postgres://nube:nube@127.0.0.1:5435/nube"

# URL desde la que se abre la app (desarrollo: http://localhost:5174)
ORIGIN="http://localhost:5174"

# `openssl rand -base64 32`: firma las sesiones y cifra las claves de las casas
BETTER_AUTH_SECRET=""

# Los ficheros de las familias (fotos de tickets, facturas), en el rustfs de compose.yaml
S3_ENDPOINT="http://127.0.0.1:19000"
S3_BUCKET="nube"
S3_ACCESS_KEY_ID="nube"
S3_SECRET_ACCESS_KEY="nube-desarrollo"

# El administrador del servicio: su familia al arrancar, y a quien avisa cada «Pedir acceso»
ADMIN_EMAIL=""

# Con el que avisan las copias del VPS de cómo han ido, para /admin (openssl rand -hex 32): el
# mismo en /etc/vps-backup.env del VPS. Sin él, no se recoge ningún aviso
BACKUP_REPORT_TOKEN=""

# Los correos de la app, por SMTP (Proton). Sin SMTP_HOST no se envían: solo salen en el log
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="no-reply@scholio.review"
SMTP_PASS=""
EMAIL_FROM="Nube <no-reply@scholio.review>"

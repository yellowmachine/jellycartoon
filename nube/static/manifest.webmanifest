{
	"name": "Seilide",
	"short_name": "Seilide",
	"description": "Las cosas de casa, también fuera.",
	"lang": "es",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"launch_handler": { "client_mode": ["navigate-existing", "auto"] },
	"background_color": "#09090b",
	"theme_color": "#09090b",
	"icons": [
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{
			"src": "/icon-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
	],
	"share_target": {
		"action": "/compartido",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [{ "name": "archivo", "accept": ["application/pdf", ".pdf", "image/*"] }]
		}
	},
	"shortcuts": [
		{ "name": "Gastos", "url": "/gastos" },
		{ "name": "Nevera", "url": "/nevera" },
		{ "name": "Carretera", "url": "/carretera" }
	]
}

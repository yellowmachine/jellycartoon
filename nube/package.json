{
	"name": "nube",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun run db:migrate && bun --bun vite dev --host",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview --host",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:start": "docker compose up -d db",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"familia": "bun scripts/crear-familia.ts",
		"start": "bun build/index.js",
		"test": "bun test src"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.5.10",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^20",
		"@types/nodemailer": "^8.0.0",
		"@types/qrcode": "^1.5.6",
		"@types/web-push": "^3.6.4",
		"drizzle-kit": "^0.31.10",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1012.0",
		"@fontsource/comic-neue": "5.3.0",
		"@turf/buffer": "7",
		"@turf/helpers": "7",
		"@turf/simplify": "7",
		"better-auth": "1.7.7",
		"comun": "workspace:*",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.11.2",
		"grammy": "1.46.0",
		"hls.js": "1.7.3",
		"maplibre-gl": "^6.12.0",
		"minisearch": "^7.2.0",
		"nodemailer": "^8.0.5",
		"postgres": "^3.4.9",
		"qrcode": "^1.5.4",
		"rrule": "^2.8.1",
		"web-push": "^3.6.7"
	}
}
